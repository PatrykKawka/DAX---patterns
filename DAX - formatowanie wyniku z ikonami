Zmiana Display =
VAR _Value = [Zmiana]
RETURN
    SWITCH(
        TRUE(),
        _Value > 0,
            "▲ " & FORMAT(_Value, "0.0%"),
        _Value < 0,
            "▼ " & FORMAT(ABS(_Value), "0.0%"),
        "● 0,0%"
    )


