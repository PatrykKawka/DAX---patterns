Nazwa najbliższego oddziału =
/*
SCENARIUSZ:
    Zwraca nazwę oddziału znajdującego się najbliżej aktualnie analizowanego oddziału.

WYMAGANIA WSTĘPNE:
    1. 1 wiersz = 1 oddział.
    2. nazwa_oddziału jednoznacznie identyfikuje oddział.
    3. Współrzędne geograficzne są poprawne.
    4. Miara jest używana dla pojedynczego oddziału.

WYDAJNOŚĆ:
    - TOPN(1) ogranicza wynik do jednego rekordu.
    - Drugi warunek sortowania zapewnia deterministyczny wynik,
      jeśli dwa oddziały znajdują się w identycznej odległości.
*/

VAR Lat1 =
    SELECTEDVALUE ( dim_Oddziały[szerokość_geograficzna] )
VAR Lon1 =
    SELECTEDVALUE ( dim_Oddziały[długość_geograficzna] )
VAR Oddzial =
    SELECTEDVALUE ( dim_Oddziały[nazwa_oddziału] )
VAR Lat1Rad =
    RADIANS ( Lat1 )
VAR Lon1Rad =
    RADIANS ( Lon1 )
VAR Odleglosci =
    ADDCOLUMNS (
        FILTER (
            ALL ( dim_Oddziały ),
            dim_Oddziały[nazwa_oddziału] <> Oddzial
        ),
        "@DistanceKm",
            VAR Lat2Rad =
                RADIANS ( dim_Oddziały[szerokość_geograficzna] )
            VAR Lon2Rad =
                RADIANS ( dim_Oddziały[długość_geograficzna] )
            VAR DLat =
                Lat2Rad - Lat1Rad
            VAR DLon =
                Lon2Rad - Lon1Rad
            VAR A =
                POWER ( SIN ( DLat / 2 ), 2 )
                    + COS ( Lat1Rad )
                    * COS ( Lat2Rad )
                    * POWER ( SIN ( DLon / 2 ), 2 )
            RETURN
                6371
                    * 2
                    * ASIN ( SQRT ( A ) )
    )

VAR Najblizszy =
    TOPN (
        1,
        Odleglosci,
        [@DistanceKm], ASC,
        dim_Oddziały[nazwa_oddziału], ASC
    )

RETURN
    MAXX (
        Najblizszy,
        dim_Oddziały[nazwa_oddziału]
    )
