% Sprzedaży dla TOP % Klientów = 
/*
========================================================================================
OPIS MIARY:
    Wyznacza jaki % całkowitej sprzedaży jest generowany przez podany % TOP klientów.
    
LOGIKA DZIAŁANIA:
    1. Filtruje tylko aktywnych klientów ([Total Sales] > 0).
    2. Pobiera wyznaczony % z Disconnected Table (z kontekstu wiersza lub ze slicera).
    3. Oblicza ilu dokładnie klientów odpowiada danej wartości procentowej (zaokrąglając w górę).
    4. Wyznacza sumę sprzedaży generowaną przez tę grupę (TOPN).
    5. Dzieli wynik przez całkowitą sprzedaż wszystkich aktywnych klientów.
========================================================================================
*/
VAR AktywniKlienci = 
    FILTER (
        ALLSELECTED ( dim_Klienci[id_klienta] ),
        [Total Sales] > 0
    )
VAR LiczbaAktywnychKlientów = 
    COUNTROWS ( AktywniKlienci )

VAR CałkowitaSprzedaż = 
    CALCULATE (
        [Total Sales],
        AktywniKlienci
    )

VAR WybranyPrógProcentowy = 
    SELECTEDVALUE ( 'Tabela Progi % Klientów'[PrógKlientów], 0.10 )

VAR LiczbaDocelowaKlientów = 
    CEILING ( LiczbaAktywnychKlientów * WybranyPrógProcentowy, 1 )

VAR SprzedażTopKlientów = 
    CALCULATE (
        [Total Sales],
        TOPN (
            LiczbaDocelowaKlientów,
            AktywniKlienci,
            [Total Sales],
            DESC,
            dim_Klienci[id_klienta],
            ASC
        )
    )

RETURN
    IF (
        ISBLANK ( CałkowitaSprzedaż ) || CałkowitaSprzedaż = 0,
        BLANK (),
        DIVIDE ( SprzedażTopKlientów, CałkowitaSprzedaż )
    )


