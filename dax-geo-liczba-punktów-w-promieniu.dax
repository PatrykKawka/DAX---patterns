Liczba oddziałów w promieniu 1 km = 
/*
SCENARIUSZ:
    Dla aktualnie wybranego oddziału oblicza liczbę INNYCH oddziałów, których odległość geograficzna od bieżącego oddziału wynosi <= 1 km.

WYMAGANIA WSTĘPNE:
    1. dim_Oddziały musi mieć 1 wiersz = 1 oddział.
    2. nazwa_oddziału musi jednoznacznie identyfikować oddział.
    3. szerokość_geograficzna oraz długość_geograficzna muszą być zapisane jako liczby dziesiętne w stopniach.
    4. Miara jest przeznaczona do kontekstu pojedynczego oddziału.
    5. Odległość jest liczona wzorem Haversine.
    6. Wynik oznacza odległość "w linii prostej", a nie dystans drogowy.

WYDAJNOŚĆ:
    - Zmiana ADDCOLUMNS + FILTER na zoptymalizowaną iterację SUMX zmniejsza zużycie pamięci RAM.
    - Wczesne przerwanie (BLANK) chroni CPU w kontekstach agregacji (Total).
    - Punkt referencyjny jest obliczany tylko raz w zmiennych.
*/

VAR SzerokośćReferencyjna = SELECTEDVALUE ( dim_Oddziały[szerokość_geograficzna] )
VAR DługośćReferencyjna = SELECTEDVALUE ( dim_Oddziały[długość_geograficzna] )
VAR NazwaReferencyjna = SELECTEDVALUE ( dim_Oddziały[nazwa_oddziału] )

RETURN
    // Zabezpieczenie: wykonuj kalkulację tylko gdy jest wybrany dokładnie 1 oddział
    IF (
        ISBLANK ( SzerokośćReferencyjna ) || ISBLANK ( DługośćReferencyjna ),
        BLANK (),
        VAR SzerokośćRad1 = RADIANS ( SzerokośćReferencyjna )
        VAR DługośćRad1 = RADIANS ( DługośćReferencyjna )
        
        // Wyciągnięcie pozostałych oddziałów z uwzględnieniem aktywnych filtrów na raporcie
        VAR PozostałeOddziały = 
            CALCULATETABLE (
                dim_Oddziały,
                ALLSELECTED ( dim_Oddziały ),
                dim_Oddziały[nazwa_oddziału] <> NazwaReferencyjna
            )

        RETURN
            SUMX (
                PozostałeOddziały,
                VAR SzerokośćRad2 = RADIANS ( dim_Oddziały[szerokość_geograficzna] )
                VAR DługośćRad2 = RADIANS ( dim_Oddziały[długość_geograficzna] )
                VAR RóżnicaSzerokości = SzerokośćRad2 - SzerokośćRad1
                VAR RóżnicaDługości = DługośćRad2 - DługośćRad1
                
                VAR A = 
                    POWER ( SIN ( RóżnicaSzerokości / 2 ), 2 ) 
                    + COS ( SzerokośćRad1 ) * COS ( SzerokośćRad2 ) * POWER ( SIN ( RóżnicaDługości / 2 ), 2 )
                
                VAR DystansKm = 6371 * 2 * ASIN ( SQRT ( A ) )
                
                RETURN
                    IF ( DystansKm <= 1, 1, 0 )
            )
    )
