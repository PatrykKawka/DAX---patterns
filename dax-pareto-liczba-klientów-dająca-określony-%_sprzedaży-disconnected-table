Liczba klientów dla % Pareto ze Slicera = 
/*
========================================================================================
OPIS MIARY:
    Wyznacza liczbę klientów potrzebnych do osiągnięcia progu % sprzedaży 
    wybranego dynamicznie na slicerze z [Parametr Próg Pareto].

ZASADA DZIAŁANIA I ZABEZPIECZENIA:
    1. FILTER(..., [Total Sales] > 0): Ignoruje klientów bez sprzedaży.
    2. ORDERBY(..., [Total Sales] DESC, dim_Klienci[id_klienta] ASC): Zabezpieczenie przed 
       remisami (ties), gwarantujące unikalne pozycje w rankingu.
    3. Pętla skumulowana: Sprawdza warunek zamykający próg (poprzednik < ProcentZeSlicera).
========================================================================================
*/

VAR ProcentZeSlicera = 
    SELECTEDVALUE ( 'Parametr Próg Pareto'[Parametr Próg Pareto], 0.80 )


VAR CałkowitaSprzedaż = 
    CALCULATE (
        [Total Sales],
        ALLSELECTED ( dim_Klienci[id_klienta] )
    )

VAR PrógKwotowy = CałkowitaSprzedaż * ProcentZeSlicera

VAR AktywniKlienci = 
    FILTER (
        ALLSELECTED ( dim_Klienci[id_klienta] ),
        [Total Sales] > 0
    )

VAR TabelaZeSkumulowaną = 
    ADDCOLUMNS (
        AktywniKlienci,
        "@Skumulowana",
            CALCULATE (
                [Total Sales],
                WINDOW (
                    1, ABS,
                    0, REL,
                    AktywniKlienci,
                    ORDERBY ( [Total Sales], DESC, dim_Klienci[id_klienta], ASC ),
                    KEEP,
                    MATCHBY ( dim_Klienci[id_klienta] )
                )
            )
    )

VAR KlienciTworzącyPróg = 
    FILTER (
        TabelaZeSkumulowaną,
        [@Skumulowana] - [Total Sales] < PrógKwotowy
    )

RETURN
    IF (
        ISBLANK ( CałkowitaSprzedaż ) || CałkowitaSprzedaż = 0,
        BLANK (),
        COUNTROWS ( KlienciTworzącyPróg )
    )
