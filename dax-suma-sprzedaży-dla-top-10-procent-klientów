Suma sprzedaży dla TOP10% klientow = 
/*
SCENARIUSZ:
    Oblicza sumę wartości sprzedaży [Total Sales] wygenerowaną wyłącznie przez TOP 10% klientow o największej wartości zakupow w aktualnym kontekście filtrowania.

WYMAGANIA WSTĘPNE:
    1. dim_Klienci musi posiadać klucz głowny id_klienta (1 wiersz = 1 unikalny klient).
    2. W modelu musi istnieć miara bazowa [Total Sales] obliczająca sumę sprzedaży.
    3. Relacja pomiędzy dim_Klienci a fact_Sprzedaz musi być oparta na kolumnie id_klienta (1:N).

WYDAJNOŚĆ:
    - Wyznaczenie liczby i tabeli 10% najlepszych klientow następuje jednorazowo w zmiennych (RAM).
    - Użycie ALLSELECTED eliminuje niepotrzebne skanowanie pełnej tabeli faktow i ogranicza zakres do aktywnego filtra.
    - CEILING / ROUNDUP gwarantuje zaokrąglenie liczby klientow w gorę do liczby całkowitej.
    - KEEPFILTERS zapobiega nadpisywaniu kontekstu wiersza w wizualizacjach z podziałem na klientow.
*/

VAR LiczbaWszystkichKlientow = 
    CALCULATE ( 
        COUNTROWS ( dim_Klienci ), 
        ALLSELECTED ( dim_Klienci ) 
    )

VAR LiczbaDocelowaKlientow = ROUNDUP ( LiczbaWszystkichKlientow * 0.10, 0 )

VAR TabelaTopKlientow = 
    TOPN (
        LiczbaDocelowaKlientow,
        ALLSELECTED ( dim_Klienci[customerkey] ),
        [Total Sales],
        DESC
    )

RETURN
    CALCULATE (
        [Total Sales],
        KEEPFILTERS ( TabelaTopKlientow )
    )
